# Database (Postgres recommended for production; SQLite works for local dev)
DATABASE_URL="postgresql://user:password@localhost:5432/artha?schema=public"

# Auth
JWT_SECRET="replace-with-a-long-random-string"

# Client credentials vault encryption key — 32 random bytes, base64-encoded.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENC_KEY=""

# Anthropic API key for the agents in src/lib/agents.ts (document-chase,
# reconciliation). Without it, agents fall back to a deterministic stub —
# same pattern as the WhatsApp/email stub mode below.
ANTHROPIC_API_KEY=""

# WhatsApp Business API (e.g. via Meta Cloud API or a BSP like Gupshup/Twilio)
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Email (SMTP or provider like Resend/SendGrid)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Artha <no-reply@artha.example>"

# Document vault storage (S3-compatible: AWS S3, Cloudflare R2, Backblaze B2, MinIO...)
# Leave unset to fall back to local disk storage (dev only — not for production/serverless).
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Razorpay (billing)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# App
APP_URL="http://localhost:3000"

# Secret for the recurring-task-generation cron endpoint (see src/app/api/cron)
CRON_SECRET="replace-with-a-long-random-string"
